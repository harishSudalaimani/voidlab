# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# demo  -> local signed-cookie session (development only)
# auth0 -> real Auth0 OIDC login (requires the AUTH0_* values below)
AUTH_MODE=demo
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Local Postgres from docker-compose.yml
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://planner:planner@localhost:5432/planner

# ---------------------------------------------------------------------------
# Auth0 (required when AUTH_MODE=auth0)
# ---------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex secret, e.g. `openssl rand -hex 32`
AUTH0_SECRET=
# Optional custom API audience (access tokens for downstream APIs)
AUTH0_AUDIENCE=

# Signing secret for demo-mode session cookies.
# Required when AUTH_MODE=demo outside development.
DEMO_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Optional OpenFGA. Leave blank to use the local database-backed demo roles.
# ---------------------------------------------------------------------------
FGA_API_URL=
FGA_STORE_ID=
FGA_MODEL_ID=
