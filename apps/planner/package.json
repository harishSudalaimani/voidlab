{
  "name": "@voidlab/planner",
  "version": "0.1.0",
  "private": true,
  "description": "Northstar — a yearly planner and bucket list with Auth0 authentication and OpenFGA authorization.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset.mjs",
    "fga:init": "node scripts/fga-init.mjs",
    "setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.33.0",
    "@openfga/sdk": "^0.9.8",
    "dotenv": "^17.2.3",
    "jose": "^6.1.2",
    "lucide-react": "^0.548.0",
    "next": "16.4.6",
    "pg": "^8.16.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
